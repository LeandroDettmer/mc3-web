# Midnight Club 3: DUB Edition Remix -- names and folders (read by tools/env.sh).
MC3_GAME_TITLE="Midnight Club 3: DUB Edition Remix"
MC3_SHORT_NAME="Midnight Club 3 Remix"   # short name (no colon)
MC3_APP_DEFAULT=mcdub3remix          # mcdub3remix.js / .wasm (browser), mcdub3remix (Linux)
MC3_DISC_PREFIX=game-remix           # discs in game-remix/ and game-remix-<edition>/
