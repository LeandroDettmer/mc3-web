# Game data: never commit anything from the disc.
/source/
/game/
# Other editions' and games' discs beside game/ (game-eur/, game-remix/,
# game-remix-eur/, ...): never committed.
/game-*/
*.iso
*.xbe
*.xiso
*_analysis.json

# Generated by tools/regen.sh (lifted C, ~100 MB) and the builds: one work
# folder per game (work-dub/, work-remix/); work/ before the split.
/work/
/work-*/
/gen/
/build*/

# Toolkit pipeline outputs, written inside the vendored tree.
/xboxrecomp/tools/*/output/

# Host clutter.
.DS_Store
__pycache__/
*.pyc
.vscode/
.idea/

# Personal folders
keys
bugs
drafts
assets/*
!assets/game-logo.jpeg
!preview.png
TODO.md
# Personal HD texture packs (beside game/; see hd_pack.c): never committed.
/hd/

# Owner-only deployment (plans, firebase.json, Worker, keys): never committed
/.deploy/
